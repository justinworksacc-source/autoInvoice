# Copy this file to `.env` and fill in the values.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Temporary testing option. Prefer refresh-token setup for normal use.
GMAIL_ACCESS_TOKEN=

# Optional: send invoice payload to your own email service instead of Gmail API.
SEND_INVOICE_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec
SEND_INVOICE_SECRET=replace-with-a-private-shared-secret

# Supabase PostgreSQL for the Vercel JavaScript API. Prefer the Supavisor
# transaction-pooler URI (port 6543) for serverless functions.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres

# Business-date automation (IANA timezone and a private cron endpoint secret).
APP_TIMEZONE=Asia/Manila
CRON_SECRET=replace-with-a-long-random-value

# Comma-separated trusted browser origins. Production should use HTTPS only.
APP_ALLOWED_ORIGINS=https://billing.example.com

# Xendit hosted checkout. Keep the secret key in Vercel environment variables only.
XENDIT_SECRET_KEY=xnd_development_replace_me
XENDIT_WEBHOOK_TOKEN=replace-with-the-token-from-xendit-dashboard
APP_PUBLIC_URL=https://billing.example.com

# Vercel JavaScript API security and PostgreSQL TLS.
SESSION_SECRET=replace-with-at-least-32-random-characters
DB_SSL=true
